<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <Appenders>
        <!-- 1. Prints logs to the console (terminal) -->
        <Console name="ConsoleLogger" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%-5level] %c{1} - %msg%n"/>
        </Console>

        <!-- 2. Saves logs to a file -->
        <File name="FileLogger" fileName="logs/qma-service.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%-5level] %c{1} - %msg%n"/>
        </File>
    </Appenders>

    <Loggers>
        <!-- Application specific debug logs -->
        <Logger name="com.quantitymeasurement" level="TRACE" />

        <!-- 3. Applies both console and file logging to the entire application -->
        <Root level="INFO">
            <AppenderRef ref="ConsoleLogger"/>
            <AppenderRef ref="FileLogger"/>
        </Root>
    </Loggers>
</Configuration>
